{
  "name": "@sami/opencode-zai-vision",
  "version": "1.0.0",
  "description": "OpenCode plugin for ZAI vision - converts pasted images to temp files for MCP vision tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "opencode",
    "plugin",
    "zai",
    "vision",
    "image"
  ],
  "license": "MIT"
}
